---
import "../styles/global.css";
import { absolute, withBase } from "../lib/paths";
// Mêmes fichiers que ceux référencés par les feuilles de fontsource : Vite leur donne la même empreinte.
import geistUrl from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import serifUrl from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = noindex ? undefined : new URL(Astro.url.pathname, Astro.site);
const ogImage = absolute(Astro.site, "og.png");
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Langue choisie avant le premier affichage : ?lang=, sinon le dernier choix, sinon la langue du navigateur.
      (function () {
        var lang;
        try {
          var asked = new URLSearchParams(location.search).get("lang");
          if (asked === "fr" || asked === "en") {
            lang = asked;
            localStorage.setItem("lang", asked);
            history.replaceState(null, "", location.pathname + location.hash);
          } else {
            lang = localStorage.getItem("lang");
          }
        } catch (e) {}
        if (lang !== "fr" && lang !== "en") {
          lang = (navigator.language || "").toLowerCase().indexOf("en") === 0 ? "en" : "fr";
        }
        document.documentElement.lang = lang;
      })();
    </script>
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <link rel="sitemap" href={withBase("sitemap-index.xml")} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:locale:alternate" content="en_GB" />
    <meta property="og:site_name" content="Joakim Janssens" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta
      property="og:image:alt"
      content="Joakim Janssens. Des sites qui convertissent. Des IA qui restent chez vous."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@joe_ghl" />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.add("motion");
      // Filet de sécurité : si le script de fin de page ne tourne pas, la page s'affiche finie.
      setTimeout(function () {
        if (!window.__motion) document.documentElement.classList.remove("motion");
      }, 3000);
    </script>
  </head>
  <body class="bg-bg">
    <slot />
    <script is:inline>
      (function () {
        window.__motion = true;
        var groups = document.querySelectorAll("[data-group]");
        if (!("IntersectionObserver" in window)) {
          groups.forEach(function (g) { g.classList.add("is-in"); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            });
          },
          { rootMargin: "0px 0px -10% 0px" },
        );
        // On attend les polices (700 ms au plus) pour que le nom n'entre pas en police de secours.
        var started = false;
        var start = function () {
          if (started) return;
          started = true;
          groups.forEach(function (g) { io.observe(g); });
        };
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(start);
        setTimeout(start, 700);
      })();
    </script>
  </body>
</html>
