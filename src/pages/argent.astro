---
import Base from "../layouts/Base.astro";
import App from "../components/argent2/App";
import "@fontsource/instrument-sans/400.css";
import "@fontsource/instrument-sans/500.css";
import "../components/argent2/theme.css";
// Mêmes fichiers que ceux des feuilles fontsource : Vite leur donne la même empreinte.
import sans400 from "@fontsource/instrument-sans/files/instrument-sans-latin-400-normal.woff2?url";
import sans500 from "@fontsource/instrument-sans/files/instrument-sans-latin-500-normal.woff2?url";
// Outil perso : les données restent dans le navigateur (localStorage), la synchro n'envoie qu'un bloc chiffré.
---

<Base
  title="Argent"
  description=""
  hidden
  preloadFonts={false}
  themeColor="#FFFFFF"
  viewport="width=device-width, initial-scale=1, viewport-fit=cover"
>
  <Fragment slot="head">
    <link rel="manifest" href="/argent/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/argent/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Argent" />
    <link rel="preload" href={sans400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sans500} as="font" type="font/woff2" crossorigin />
  </Fragment>
  <App client:only="preact" />
  <script is:inline>
    if ("serviceWorker" in navigator) {
      addEventListener("load", () => navigator.serviceWorker.register("/argent/sw.js", { scope: "/argent/" }).catch(() => {}));
    }
  </script>
</Base>
