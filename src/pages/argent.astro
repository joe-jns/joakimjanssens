---
import Base from "../layouts/Base.astro";
// Outil perso : rien n'est envoyé au serveur, tout reste dans le navigateur du téléphone (localStorage).
---

<Base title="Argent" description="" hidden>
  <Fragment slot="head">
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Argent" />
  </Fragment>

  <main class="mx-auto flex w-full max-w-[520px] flex-col gap-7 px-4 pt-8 pb-16 text-body">
    <header class="flex flex-col gap-1">
      <p class="text-[13px] leading-5 text-muted">Aujourd’hui, <span id="today-label"></span></p>
      <p class="font-display text-[56px] leading-[1.05] text-ink" id="balance">0 €</p>
      <p class="text-[13px] leading-5 text-muted" id="balance-note"></p>
    </header>

    <button
      id="day-done"
      type="button"
      class="flex h-14 items-center justify-center gap-2 rounded-2xl bg-ink text-base font-medium text-cream transition-[background-color,scale] duration-150 active:scale-[0.98]"
    >
      Journée finie <span id="day-amount" class="text-accent">+100 €</span>
    </button>
    <p id="day-hint" class="-mt-5 hidden text-center text-[13px] leading-5 text-muted"></p>

    <!-- Journées oubliées : repliées, on en a rarement besoin -->
    <details class="-mt-4 text-[13px] leading-5 text-muted">
      <summary class="plain mx-auto w-fit cursor-pointer underline decoration-hairline underline-offset-4">
        Ajouter des journées oubliées
      </summary>
      <form id="past" class="mt-3 flex flex-col gap-2 rounded-2xl p-3 ring-hairline">
        <div class="grid grid-cols-2 gap-2">
          <label class="flex flex-col gap-1">
            Du
            <input id="past-from" type="date" required class="h-11 rounded-xl bg-bg px-3 text-base text-ink ring-hairline outline-none focus:shadow-[inset_0_0_0_1.5px_#111]" />
          </label>
          <label class="flex flex-col gap-1">
            Au
            <input id="past-to" type="date" required class="h-11 rounded-xl bg-bg px-3 text-base text-ink ring-hairline outline-none focus:shadow-[inset_0_0_0_1.5px_#111]" />
          </label>
        </div>
        <button id="past-submit" type="submit" class="h-10 rounded-xl bg-surface text-sm font-medium text-ink active:scale-[0.98]">
          Ajouter les journées
        </button>
        <p>Du lundi au vendredi seulement. Un jour déjà compté n’est pas ajouté deux fois.</p>
      </form>
    </details>

    <!-- Ajouter un mouvement -->
    <section class="flex flex-col gap-3 rounded-2xl bg-surface p-4" aria-labelledby="t-add">
      <h2 id="t-add" class="text-sm font-medium text-ink">Ajouter un mouvement</h2>
      <form id="add" class="flex flex-col gap-3">
        <div class="grid grid-cols-2 gap-1 rounded-xl bg-bg p-1 text-sm font-medium" role="radiogroup" aria-label="Sens">
          <button type="button" data-sign="-1" class="sign h-9 rounded-lg">− Je dois / dépense</button>
          <button type="button" data-sign="1" class="sign h-9 rounded-lg">+ Je reçois</button>
        </div>
        <div class="grid grid-cols-[1fr_auto] gap-2">
          <input
            id="f-amount"
            inputmode="decimal"
            placeholder="Montant (€)"
            required
            class="h-11 min-w-0 rounded-xl bg-bg px-3 text-base text-ink ring-hairline outline-none focus:shadow-[inset_0_0_0_1.5px_#111]"
          />
          <input
            id="f-date"
            type="date"
            required
            class="h-11 rounded-xl bg-bg px-3 text-base text-ink ring-hairline outline-none focus:shadow-[inset_0_0_0_1.5px_#111]"
          />
        </div>
        <input
          id="f-label"
          placeholder="Pour quoi ? (ex. maman)"
          class="h-11 rounded-xl bg-bg px-3 text-base text-ink ring-hairline outline-none focus:shadow-[inset_0_0_0_1.5px_#111]"
        />
        <button type="submit" class="h-11 rounded-xl bg-ink text-sm font-medium text-cream active:scale-[0.98]">
          Ajouter
        </button>
      </form>
    </section>

    <!-- Paiements récurrents -->
    <section class="flex flex-col gap-3 rounded-2xl bg-surface p-4" aria-labelledby="t-rec">
      <h2 id="t-rec" class="text-sm font-medium text-ink">Paiements récurrents</h2>
      <ul id="rec-list" class="flex flex-col"></ul>
      <details id="rec-details" class="text-sm">
        <summary class="plain cursor-pointer text-body">+ Ajouter un paiement récurrent</summary>
        <form id="rec" class="mt-3 flex flex-col gap-3">
          <div class="grid grid-cols-2 gap-1 rounded-xl bg-bg p-1 text-sm font-medium" role="radiogroup" aria-label="Sens">
            <button type="button" data-rsign="-1" class="sign h-9 rounded-lg">− Je paie</button>
            <button type="button" data-rsign="1" class="sign h-9 rounded-lg">+ Je reçois</button>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <input id="r-amount" inputmode="decimal" placeholder="Montant (€)" required class="min-w-0 h-11 rounded-xl bg-bg px-3 text-base text-ink ring-hairline outline-none focus:shadow-[inset_0_0_0_1.5px_#111]" />
            <input id="r-label" placeholder="Pour quoi ? (ex. loyer)" class="min-w-0 h-11 rounded-xl bg-bg px-3 text-base text-ink ring-hairline outline-none focus:shadow-[inset_0_0_0_1.5px_#111]" />
          </div>
          <div class="grid grid-cols-2 gap-2">
            <label class="flex flex-col gap-1 text-[13px] text-muted">
              Revient
              <select id="r-every" class="h-11 rounded-xl bg-bg px-3 text-base text-ink ring-hairline outline-none focus:shadow-[inset_0_0_0_1.5px_#111]">
                <option value="month">Chaque mois</option>
                <option value="week">Chaque semaine</option>
                <option value="2weeks">Toutes les 2 semaines</option>
              </select>
            </label>
            <label class="flex flex-col gap-1 text-[13px] text-muted">
              Prochaine fois le
              <input id="r-first" type="date" required class="h-11 rounded-xl bg-bg px-3 text-base text-ink ring-hairline outline-none focus:shadow-[inset_0_0_0_1.5px_#111]" />
            </label>
          </div>
          <button type="submit" class="h-11 rounded-xl bg-ink text-sm font-medium text-cream active:scale-[0.98]">
            Ajouter
          </button>
        </form>
      </details>
    </section>

    <!-- Projection -->
    <section class="flex flex-col gap-3 rounded-2xl bg-surface p-4" aria-labelledby="t-proj">
      <h2 id="t-proj" class="text-sm font-medium text-ink">Combien j’aurai le…</h2>
      <input id="p-date" type="date" class="h-11 rounded-xl bg-bg px-3 text-base text-ink ring-hairline outline-none" />
      <input id="p-range" type="range" min="0" max="120" value="0" class="w-full accent-[#111]" aria-label="Jours à partir d’aujourd’hui" />
      <p class="font-display text-[44px] leading-[1.1] text-ink" id="p-result">0 €</p>
      <p class="text-[13px] leading-5 text-muted" id="p-detail"></p>
      <label class="flex items-center gap-2 text-sm">
        <input id="p-workdays" type="checkbox" class="size-4 accent-[#111]" />
        Compter mes journées à venir (lun–ven, payées le jeudi d’après)
      </label>
    </section>

    <!-- Mouvements -->
    <section class="flex flex-col gap-3" aria-labelledby="t-list">
      <div class="flex items-baseline justify-between gap-3">
        <h2 id="t-list" class="text-sm font-medium text-ink">Mouvements</h2>
        <p class="text-[13px] text-muted">Touche un montant pour le corriger</p>
      </div>
      <ul id="list" class="flex flex-col"></ul>
      <p id="empty" class="text-sm text-muted">
        Rien pour l’instant. Commence par ajouter ce que tu as aujourd’hui (« + Je reçois », libellé « départ »).
      </p>
    </section>

    <!-- Réglages -->
    <details class="rounded-2xl bg-surface p-4 text-sm">
      <summary class="cursor-pointer font-medium text-ink">Réglages et sauvegarde</summary>
      <div class="mt-4 flex flex-col gap-4">
        <label class="flex items-center justify-between gap-3">
          Montant d’une journée
          <input
            id="s-day"
            inputmode="decimal"
            class="h-10 w-28 rounded-xl bg-bg px-3 text-right text-base text-ink ring-hairline outline-none"
          />
        </label>
        <p class="text-[13px] leading-5 text-muted">
          Les données restent dans ce navigateur, sur ce téléphone. Exporte de temps en temps pour ne rien perdre.
        </p>
        <div class="grid grid-cols-2 gap-2">
          <button id="export" type="button" class="h-10 rounded-xl bg-bg ring-hairline">Exporter</button>
          <label class="flex h-10 cursor-pointer items-center justify-center rounded-xl bg-bg ring-hairline">
            Importer
            <input id="import" type="file" accept="application/json" class="hidden" />
          </label>
        </div>
      </div>
    </details>
  </main>

  <style>
    summary.plain {
      list-style: none;
    }
    summary.plain::-webkit-details-marker {
      display: none;
    }
    .sign[aria-checked="true"] {
      background: var(--color-ink);
      color: var(--color-cream);
    }
  </style>

  <script>
    type Entry = { id: string; date: string; amount: number; label: string; kind?: "day" };
    type Every = "month" | "week" | "2weeks";
    type Recurring = { id: string; first: string; every: Every; amount: number; label: string };
    type State = { entries: Entry[]; recurring: Recurring[]; dayAmount: number; workdays: boolean };

    const KEY = "argent:v1";
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    // Dates en « AAAA-MM-JJ » locales : elles se comparent comme du texte.
    const iso = (d: Date) =>
      `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
    const parse = (s: string) => {
      const [y, m, d] = s.split("-").map(Number);
      return new Date(y, m - 1, d);
    };
    const addDays = (s: string, n: number) => {
      const d = parse(s);
      d.setDate(d.getDate() + n);
      return iso(d);
    };
    const daysBetween = (a: string, b: string) => Math.round((parse(b).getTime() - parse(a).getTime()) / 86400000);
    const today = () => iso(new Date());

    const money = new Intl.NumberFormat("fr-BE", { style: "currency", currency: "EUR", maximumFractionDigits: 2 });
    const fmt = (n: number) => money.format(n).replace(",00", "");
    const signed = (n: number) => (n > 0 ? "+" : "") + fmt(n);
    const longDate = (s: string) =>
      parse(s).toLocaleDateString("fr-BE", { weekday: "long", day: "numeric", month: "long" });
    const toNumber = (v: string) => Number(v.replace(",", ".").replace(/[^\d.-]/g, ""));

    function load(): State {
      try {
        const s = JSON.parse(localStorage.getItem(KEY) || "");
        if (s && Array.isArray(s.entries)) return { recurring: [], dayAmount: 100, workdays: true, ...s };
      } catch {}
      return { entries: [], recurring: [], dayAmount: 100, workdays: true };
    }
    let state = load();
    const save = () => {
      try {
        localStorage.setItem(KEY, JSON.stringify(state));
      } catch {}
    };

    // Paie chaque jeudi pour la semaine d'avant : un jour travaillé est payé le jeudi de la semaine suivante.
    const isDay = (e: Entry) => e.kind === "day" || (e.label === "Journée" && e.amount > 0);
    const payday = (date: string) => addDays(date, 10 - ((parse(date).getDay() + 6) % 7));
    const isWorkday = (date: string) => parse(date).getDay() % 6 !== 0;

    // Dates d'un paiement récurrent jusqu'à « to » incluse. Au mois, le jour est gardé (le 31 tombe le 30 ou le 28).
    const nthDate = (r: Recurring, n: number) => {
      if (r.every !== "month") return addDays(r.first, n * (r.every === "week" ? 7 : 14));
      const f = parse(r.first);
      const last = new Date(f.getFullYear(), f.getMonth() + n + 1, 0).getDate();
      return iso(new Date(f.getFullYear(), f.getMonth() + n, Math.min(f.getDate(), last)));
    };
    const occurrences = (r: Recurring, to: string) => {
      const dates: string[] = [];
      for (let n = 0, d = r.first; d <= to && n < 1000; d = nthDate(r, ++n)) dates.push(d);
      return dates;
    };
    const recurringBetween = (from: string, to: string) =>
      state.recurring.reduce((sum, r) => sum + occurrences(r, to).filter((d) => d > from).length * r.amount, 0);

    // Argent en poche à une date : les journées ne comptent qu'une fois payées.
    const balanceAt = (date: string) =>
      state.entries
        .filter((e) => (isDay(e) ? payday(e.date) : e.date) <= date)
        .reduce((sum, e) => sum + e.amount, 0) + recurringBetween("", date);
    // Journées faites mais pas encore payées à cette date.
    const pendingAt = (date: string) =>
      state.entries.filter((e) => isDay(e) && e.date <= date && payday(e.date) > date);

    // Journées à venir (lun–ven) jusqu'à la date : aujourd'hui compte tant que le bouton n'a pas été pressé.
    const futureDays = (target: string) => {
      const t = today();
      const doneToday = state.entries.some((e) => isDay(e) && e.date === t);
      const days: string[] = [];
      for (let d = doneToday ? addDays(t, 1) : t; d <= target; d = addDays(d, 1)) if (isWorkday(d)) days.push(d);
      return days;
    };

    // --- Formulaire ---
    let sign = -1;
    const setSign = (s: number) => {
      sign = s;
      document.querySelectorAll<HTMLButtonElement>("[data-sign]").forEach((b) => {
        b.setAttribute("role", "radio");
        b.setAttribute("aria-checked", String(Number(b.dataset.sign) === s));
      });
    };
    document.querySelectorAll<HTMLButtonElement>("[data-sign]").forEach((b) =>
      b.addEventListener("click", () => setSign(Number(b.dataset.sign))),
    );

    $<HTMLFormElement>("add").addEventListener("submit", (e) => {
      e.preventDefault();
      const amount = Math.abs(toNumber($<HTMLInputElement>("f-amount").value));
      const date = $<HTMLInputElement>("f-date").value || today();
      if (!amount) return;
      state.entries.push({
        id: crypto.randomUUID(),
        date,
        amount: sign * amount,
        label: $<HTMLInputElement>("f-label").value.trim(),
      });
      save();
      $<HTMLInputElement>("f-amount").value = "";
      $<HTMLInputElement>("f-label").value = "";
      render();
    });

    // --- Journée finie ---
    $("day-done").addEventListener("click", () => {
      state.entries.push({ id: crypto.randomUUID(), date: today(), amount: state.dayAmount, label: "Journée", kind: "day" });
      save();
      render();
    });

    // --- Journées déjà faites ---
    const pastFrom = $<HTMLInputElement>("past-from");
    const pastTo = $<HTMLInputElement>("past-to");
    const pastDays = () => {
      const from = pastFrom.value;
      const to = pastTo.value;
      if (!from || !to || from > to) return [];
      const done = new Set(state.entries.filter(isDay).map((e) => e.date));
      const days: string[] = [];
      for (let d = from; d <= to; d = addDays(d, 1)) if (isWorkday(d) && !done.has(d)) days.push(d);
      return days;
    };
    const renderPast = () => {
      const n = pastDays().length;
      const btn = $<HTMLButtonElement>("past-submit");
      btn.disabled = !n;
      btn.classList.toggle("opacity-40", !n);
      btn.textContent = n
        ? `Ajouter ${n} journée${n > 1 ? "s" : ""} · ${signed(n * state.dayAmount)}`
        : "Rien à ajouter sur ces dates";
    };
    pastFrom.addEventListener("change", renderPast);
    pastTo.addEventListener("change", renderPast);
    $<HTMLFormElement>("past").addEventListener("submit", (e) => {
      e.preventDefault();
      for (const date of pastDays())
        state.entries.push({ id: crypto.randomUUID(), date, amount: state.dayAmount, label: "Journée", kind: "day" });
      save();
      render();
    });

    // --- Paiements récurrents ---
    let rsign = -1;
    const setRsign = (s: number) => {
      rsign = s;
      document.querySelectorAll<HTMLButtonElement>("[data-rsign]").forEach((b) => {
        b.setAttribute("role", "radio");
        b.setAttribute("aria-checked", String(Number(b.dataset.rsign) === s));
      });
    };
    document.querySelectorAll<HTMLButtonElement>("[data-rsign]").forEach((b) =>
      b.addEventListener("click", () => setRsign(Number(b.dataset.rsign))),
    );
    $<HTMLFormElement>("rec").addEventListener("submit", (e) => {
      e.preventDefault();
      const amount = Math.abs(toNumber($<HTMLInputElement>("r-amount").value));
      if (!amount) return;
      state.recurring.push({
        id: crypto.randomUUID(),
        first: $<HTMLInputElement>("r-first").value || today(),
        every: $<HTMLSelectElement>("r-every").value as Every,
        amount: rsign * amount,
        label: $<HTMLInputElement>("r-label").value.trim(),
      });
      save();
      $<HTMLInputElement>("r-amount").value = "";
      $<HTMLInputElement>("r-label").value = "";
      ($("rec-details") as HTMLDetailsElement).open = false;
      render();
    });

    const everyLabel = (r: Recurring) =>
      r.every === "week"
        ? `chaque ${parse(r.first).toLocaleDateString("fr-BE", { weekday: "long" })}`
        : r.every === "2weeks"
          ? "toutes les 2 semaines"
          : `chaque mois le ${parse(r.first).getDate()}`;

    function renderRecurring() {
      const t = today();
      const list = $("rec-list");
      list.replaceChildren();
      for (const r of state.recurring) {
        const next = occurrences(r, addDays(t, 400)).find((d) => d > t) ?? r.first;
        const li = document.createElement("li");
        li.className = "flex items-center gap-3 border-b border-hairline py-3";
        li.innerHTML = `
          <div class="min-w-0 flex-1">
            <p class="truncate text-[15px] text-ink"></p>
            <p class="text-[13px] text-muted"></p>
          </div>
          <button type="button" data-amount class="h-9 text-[15px] font-medium tabular-nums underline decoration-hairline decoration-dotted underline-offset-4" aria-label="Corriger le montant"></button>
          <button type="button" data-del class="-mr-2 size-9 rounded-lg text-muted active:bg-bg" aria-label="Supprimer">✕</button>`;
        const [label, when] = li.querySelectorAll("div p");
        label.textContent = r.label || (r.amount > 0 ? "Rentrée" : "Paiement");
        when.textContent = `${everyLabel(r)} · prochain le ${longDate(next)}`;
        const amount = li.querySelector<HTMLButtonElement>("[data-amount]")!;
        amount.textContent = signed(r.amount);
        amount.classList.add(r.amount > 0 ? "text-ink" : "text-[#b4234a]");
        amount.addEventListener("click", () => editAmount(amount, r));
        li.querySelector("[data-del]")!.addEventListener("click", () => {
          if (!confirmDelete(li)) return;
          state.recurring = state.recurring.filter((x) => x.id !== r.id);
          save();
          render();
        });
        list.append(li);
      }
    }

    // --- Projection ---
    const pDate = $<HTMLInputElement>("p-date");
    const pRange = $<HTMLInputElement>("p-range");
    pRange.addEventListener("input", () => {
      pDate.value = addDays(today(), Number(pRange.value));
      renderProjection();
    });
    pDate.addEventListener("change", () => {
      const n = Math.max(0, daysBetween(today(), pDate.value || today()));
      pRange.max = String(Math.max(120, n));
      pRange.value = String(n);
      renderProjection();
    });
    $<HTMLInputElement>("p-workdays").addEventListener("change", (e) => {
      state.workdays = (e.target as HTMLInputElement).checked;
      save();
      renderProjection();
    });

    // --- Réglages ---
    $<HTMLInputElement>("s-day").addEventListener("change", (e) => {
      const n = toNumber((e.target as HTMLInputElement).value);
      if (n > 0) state.dayAmount = n;
      save();
      render();
    });
    $("export").addEventListener("click", () => {
      const blob = new Blob([JSON.stringify(state, null, 2)], { type: "application/json" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `argent-${today()}.json`;
      a.click();
      URL.revokeObjectURL(a.href);
    });
    $<HTMLInputElement>("import").addEventListener("change", async (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;
      try {
        const s = JSON.parse(await file.text());
        if (!Array.isArray(s.entries)) throw 0;
        state = { recurring: [], dayAmount: 100, workdays: true, ...s };
        save();
        render();
      } catch {
        $("balance-note").textContent = "Fichier illisible, rien n’a été importé.";
      }
    });

    // --- Rendu ---
    function renderProjection() {
      const target = pDate.value || today();
      const t = today();
      const days = state.workdays ? futureDays(target) : [];
      const paidDays = days.filter((d) => payday(d) <= target).length;
      $("p-result").textContent = fmt(balanceAt(target) + paidDays * state.dayAmount);

      // Ce qui arrive entre aujourd'hui et la date : paies du jeudi d'un côté, mouvements prévus de l'autre.
      const between = (e: Entry) => {
        const d = isDay(e) ? payday(e.date) : e.date;
        return d > t && d <= target;
      };
      const pay =
        state.entries.filter((e) => isDay(e) && between(e)).reduce((s, e) => s + e.amount, 0) +
        paidDays * state.dayAmount;
      const planned = state.entries.filter((e) => !isDay(e) && between(e)).reduce((s, e) => s + e.amount, 0);
      const later =
        pendingAt(target).reduce((s, e) => s + e.amount, 0) + (days.length - paidDays) * state.dayAmount;

      const parts = [`en poche le ${longDate(target)}`, `aujourd’hui ${fmt(balanceAt(t))}`];
      if (pay) parts.push(`paies du jeudi ${signed(pay)}`);
      if (planned) parts.push(`prévus ${signed(planned)}`);
      const rec = recurringBetween(t, target);
      if (rec) parts.push(`récurrents ${signed(rec)}`);
      if (later) parts.push(`puis ${signed(later)} déjà gagnés, payés plus tard`);
      $("p-detail").textContent = parts.join(" · ");
    }

    function render() {
      const t = today();
      $("today-label").textContent = longDate(t);
      $("balance").textContent = fmt(balanceAt(t));
      // Prochaine paie : les journées déjà faites qui tombent le jeudi suivant.
      const pending = pendingAt(t);
      const next = pending.map((e) => payday(e.date)).sort()[0];
      const nextSum = pending.filter((e) => payday(e.date) === next).reduce((s, e) => s + e.amount, 0);
      const rest = pending.reduce((s, e) => s + e.amount, 0) - nextSum;
      $("balance-note").textContent = next
        ? `${signed(nextSum)} à recevoir le ${longDate(next)}` + (rest ? ` · puis ${signed(rest)}` : "")
        : "";
      $("day-amount").textContent = signed(state.dayAmount);
      $<HTMLInputElement>("s-day").value = String(state.dayAmount);
      $<HTMLInputElement>("p-workdays").checked = state.workdays;

      const doneToday = state.entries.filter((e) => e.date === t && isDay(e)).length;
      const hint = $("day-hint");
      hint.classList.toggle("hidden", !doneToday);
      hint.textContent = doneToday > 1 ? `Comptée ${doneToday} fois aujourd’hui.` : "Journée d’aujourd’hui comptée.";

      const list = $("list");
      list.replaceChildren();
      const sorted = [...state.entries].sort((a, b) => b.date.localeCompare(a.date));
      $("empty").classList.toggle("hidden", sorted.length > 0);
      for (const e of sorted) {
        const li = document.createElement("li");
        li.className = "flex items-center gap-3 border-b border-hairline py-3";
        const due = isDay(e) ? payday(e.date) : e.date;
        const future = due > t;
        li.innerHTML = `
          <div class="min-w-0 flex-1">
            <p class="truncate text-[15px] text-ink"></p>
            <p class="text-[13px] text-muted"></p>
          </div>
          <button type="button" data-amount class="h-9 text-[15px] font-medium tabular-nums underline decoration-hairline decoration-dotted underline-offset-4" aria-label="Corriger le montant"></button>
          <button type="button" data-del class="-mr-2 size-9 rounded-lg text-muted active:bg-surface" aria-label="Supprimer">✕</button>`;
        const [label, date] = li.querySelectorAll("div p");
        label.textContent = e.label || (e.amount > 0 ? "Rentrée" : "Sortie");
        date.textContent = isDay(e)
          ? `${longDate(e.date)} · ${future ? "payée le" : "payée"} ${longDate(due)}`
          : (future ? "Prévu · " : "") + longDate(e.date);
        const amount = li.querySelector<HTMLButtonElement>("[data-amount]")!;
        amount.textContent = signed(e.amount);
        amount.classList.add(e.amount > 0 ? "text-ink" : "text-[#b4234a]");
        if (future) li.classList.add("opacity-70");
        amount.addEventListener("click", () => editAmount(amount, e));
        li.querySelector("[data-del]")!.addEventListener("click", () => {
          if (!confirmDelete(li)) return;
          state.entries = state.entries.filter((x) => x.id !== e.id);
          save();
          render();
        });
        list.append(li);
      }
      renderPast();
      renderRecurring();
      renderProjection();
    }

    // Toucher un montant le remplace par un champ : le signe d'origine est gardé (une dette reste une dette).
    function editAmount(btn: HTMLButtonElement, e: { amount: number }) {
      const input = document.createElement("input");
      input.inputMode = "decimal";
      input.value = String(Math.abs(e.amount)).replace(".", ",");
      input.className =
        "h-9 w-24 rounded-lg bg-surface px-2 text-right text-base font-medium text-ink tabular-nums outline-none ring-hairline";
      let done = false;
      const commit = () => {
        if (done) return;
        done = true;
        const n = Math.abs(toNumber(input.value));
        if (n) {
          e.amount = Math.sign(e.amount) * n;
          save();
        }
        render();
      };
      input.addEventListener("blur", commit);
      input.addEventListener("keydown", (k) => {
        if (k.key === "Enter") input.blur();
        if (k.key === "Escape") {
          done = true;
          render();
        }
      });
      btn.replaceWith(input);
      input.focus();
      input.select();
    }

    // Suppression en deux taps : le premier arme la croix, le second supprime.
    function confirmDelete(li: HTMLElement) {
      const btn = li.querySelector<HTMLButtonElement>("[data-del]")!;
      if (btn.dataset.armed) return true;
      btn.dataset.armed = "1";
      btn.textContent = "Sûr ?";
      btn.className = "-mr-1 h-9 rounded-lg px-2 text-[13px] font-medium text-[#b4234a]";
      setTimeout(() => render(), 2500);
      return false;
    }

    setSign(-1);
    setRsign(-1);
    $<HTMLInputElement>("r-first").value = today();
    $<HTMLInputElement>("f-date").value = today();
    pDate.value = today();
    pastFrom.value = pastTo.value = addDays(today(), -1);
    render();
  </script>
</Base>
