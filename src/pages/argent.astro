---
import Base from "../layouts/Base.astro";
// Outil perso : rien n'est envoyé au serveur, tout reste dans le navigateur du téléphone (localStorage).
---

<Base title="Argent" description="" hidden>
  <Fragment slot="head">
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Argent" />
  </Fragment>

  <main class="mx-auto flex w-full max-w-[520px] flex-col gap-7 px-4 pt-8 pb-16 text-body">
    <header class="flex flex-col gap-1">
      <p class="text-[13px] leading-5 text-muted">Aujourd’hui, <span id="today-label"></span></p>
      <p class="font-display text-[56px] leading-[1.05] text-ink" id="balance">0 €</p>
      <p class="text-[13px] leading-5 text-muted" id="balance-note"></p>
    </header>

    <button
      id="day-done"
      type="button"
      class="flex h-14 items-center justify-center gap-2 rounded-2xl bg-ink text-base font-medium text-cream transition-[background-color,scale] duration-150 active:scale-[0.98]"
    >
      Journée finie <span id="day-amount" class="text-accent">+100 €</span>
    </button>
    <p id="day-hint" class="-mt-5 hidden text-center text-[13px] leading-5 text-muted"></p>

    <!-- Ajouter un mouvement -->
    <section class="flex flex-col gap-3 rounded-2xl bg-surface p-4" aria-labelledby="t-add">
      <h2 id="t-add" class="text-sm font-medium text-ink">Ajouter un mouvement</h2>
      <form id="add" class="flex flex-col gap-3">
        <div class="grid grid-cols-2 gap-1 rounded-xl bg-bg p-1 text-sm font-medium" role="radiogroup" aria-label="Sens">
          <button type="button" data-sign="-1" class="sign h-9 rounded-lg">− Je dois / dépense</button>
          <button type="button" data-sign="1" class="sign h-9 rounded-lg">+ Je reçois</button>
        </div>
        <div class="grid grid-cols-[1fr_auto] gap-2">
          <input
            id="f-amount"
            inputmode="decimal"
            placeholder="Montant (€)"
            required
            class="h-11 min-w-0 rounded-xl bg-bg px-3 text-base text-ink ring-hairline outline-none focus:shadow-[inset_0_0_0_1.5px_#111]"
          />
          <input
            id="f-date"
            type="date"
            required
            class="h-11 rounded-xl bg-bg px-3 text-base text-ink ring-hairline outline-none focus:shadow-[inset_0_0_0_1.5px_#111]"
          />
        </div>
        <input
          id="f-label"
          placeholder="Pour quoi ? (ex. maman)"
          class="h-11 rounded-xl bg-bg px-3 text-base text-ink ring-hairline outline-none focus:shadow-[inset_0_0_0_1.5px_#111]"
        />
        <button type="submit" class="h-11 rounded-xl bg-ink text-sm font-medium text-cream active:scale-[0.98]">
          Ajouter
        </button>
      </form>
    </section>

    <!-- Projection -->
    <section class="flex flex-col gap-3 rounded-2xl bg-surface p-4" aria-labelledby="t-proj">
      <h2 id="t-proj" class="text-sm font-medium text-ink">Combien j’aurai le…</h2>
      <input id="p-date" type="date" class="h-11 rounded-xl bg-bg px-3 text-base text-ink ring-hairline outline-none" />
      <input id="p-range" type="range" min="0" max="120" value="0" class="w-full accent-[#111]" aria-label="Jours à partir d’aujourd’hui" />
      <p class="font-display text-[44px] leading-[1.1] text-ink" id="p-result">0 €</p>
      <p class="text-[13px] leading-5 text-muted" id="p-detail"></p>
      <label class="flex items-center gap-2 text-sm">
        <input id="p-workdays" type="checkbox" class="size-4 accent-[#111]" />
        Compter mes journées à venir (lun–ven)
      </label>
    </section>

    <!-- Mouvements -->
    <section class="flex flex-col gap-3" aria-labelledby="t-list">
      <h2 id="t-list" class="text-sm font-medium text-ink">Mouvements</h2>
      <ul id="list" class="flex flex-col"></ul>
      <p id="empty" class="text-sm text-muted">
        Rien pour l’instant. Commence par ajouter ce que tu as aujourd’hui (« + Je reçois », libellé « départ »).
      </p>
    </section>

    <!-- Réglages -->
    <details class="rounded-2xl bg-surface p-4 text-sm">
      <summary class="cursor-pointer font-medium text-ink">Réglages et sauvegarde</summary>
      <div class="mt-4 flex flex-col gap-4">
        <label class="flex items-center justify-between gap-3">
          Montant d’une journée
          <input
            id="s-day"
            inputmode="decimal"
            class="h-10 w-28 rounded-xl bg-bg px-3 text-right text-base text-ink ring-hairline outline-none"
          />
        </label>
        <p class="text-[13px] leading-5 text-muted">
          Les données restent dans ce navigateur, sur ce téléphone. Exporte de temps en temps pour ne rien perdre.
        </p>
        <div class="grid grid-cols-2 gap-2">
          <button id="export" type="button" class="h-10 rounded-xl bg-bg ring-hairline">Exporter</button>
          <label class="flex h-10 cursor-pointer items-center justify-center rounded-xl bg-bg ring-hairline">
            Importer
            <input id="import" type="file" accept="application/json" class="hidden" />
          </label>
        </div>
      </div>
    </details>
  </main>

  <style>
    .sign[aria-checked="true"] {
      background: var(--color-ink);
      color: var(--color-cream);
    }
  </style>

  <script>
    type Entry = { id: string; date: string; amount: number; label: string };
    type State = { entries: Entry[]; dayAmount: number; workdays: boolean };

    const KEY = "argent:v1";
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    // Dates en « AAAA-MM-JJ » locales : elles se comparent comme du texte.
    const iso = (d: Date) =>
      `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
    const parse = (s: string) => {
      const [y, m, d] = s.split("-").map(Number);
      return new Date(y, m - 1, d);
    };
    const addDays = (s: string, n: number) => {
      const d = parse(s);
      d.setDate(d.getDate() + n);
      return iso(d);
    };
    const daysBetween = (a: string, b: string) => Math.round((parse(b).getTime() - parse(a).getTime()) / 86400000);
    const today = () => iso(new Date());

    const money = new Intl.NumberFormat("fr-BE", { style: "currency", currency: "EUR", maximumFractionDigits: 2 });
    const fmt = (n: number) => money.format(n).replace(",00", "");
    const signed = (n: number) => (n > 0 ? "+" : "") + fmt(n);
    const longDate = (s: string) =>
      parse(s).toLocaleDateString("fr-BE", { weekday: "long", day: "numeric", month: "long" });
    const toNumber = (v: string) => Number(v.replace(",", ".").replace(/[^\d.-]/g, ""));

    function load(): State {
      try {
        const s = JSON.parse(localStorage.getItem(KEY) || "");
        if (s && Array.isArray(s.entries)) return { dayAmount: 100, workdays: true, ...s };
      } catch {}
      return { entries: [], dayAmount: 100, workdays: true };
    }
    let state = load();
    const save = () => {
      try {
        localStorage.setItem(KEY, JSON.stringify(state));
      } catch {}
    };

    const balanceAt = (date: string) =>
      state.entries.filter((e) => e.date <= date).reduce((sum, e) => sum + e.amount, 0);

    // Jours ouvrés (lun–ven) strictement après aujourd'hui, jusqu'à la date incluse.
    const workdaysUntil = (date: string) => {
      let n = 0;
      for (let d = addDays(today(), 1); d <= date; d = addDays(d, 1)) {
        const wd = parse(d).getDay();
        if (wd !== 0 && wd !== 6) n++;
      }
      return n;
    };

    // --- Formulaire ---
    let sign = -1;
    const setSign = (s: number) => {
      sign = s;
      document.querySelectorAll<HTMLButtonElement>(".sign").forEach((b) => {
        b.setAttribute("role", "radio");
        b.setAttribute("aria-checked", String(Number(b.dataset.sign) === s));
      });
    };
    document.querySelectorAll<HTMLButtonElement>(".sign").forEach((b) =>
      b.addEventListener("click", () => setSign(Number(b.dataset.sign))),
    );

    $<HTMLFormElement>("add").addEventListener("submit", (e) => {
      e.preventDefault();
      const amount = Math.abs(toNumber($<HTMLInputElement>("f-amount").value));
      const date = $<HTMLInputElement>("f-date").value || today();
      if (!amount) return;
      state.entries.push({
        id: crypto.randomUUID(),
        date,
        amount: sign * amount,
        label: $<HTMLInputElement>("f-label").value.trim(),
      });
      save();
      $<HTMLInputElement>("f-amount").value = "";
      $<HTMLInputElement>("f-label").value = "";
      render();
    });

    // --- Journée finie ---
    $("day-done").addEventListener("click", () => {
      state.entries.push({ id: crypto.randomUUID(), date: today(), amount: state.dayAmount, label: "Journée" });
      save();
      render();
    });

    // --- Projection ---
    const pDate = $<HTMLInputElement>("p-date");
    const pRange = $<HTMLInputElement>("p-range");
    pRange.addEventListener("input", () => {
      pDate.value = addDays(today(), Number(pRange.value));
      renderProjection();
    });
    pDate.addEventListener("change", () => {
      const n = Math.max(0, daysBetween(today(), pDate.value || today()));
      pRange.max = String(Math.max(120, n));
      pRange.value = String(n);
      renderProjection();
    });
    $<HTMLInputElement>("p-workdays").addEventListener("change", (e) => {
      state.workdays = (e.target as HTMLInputElement).checked;
      save();
      renderProjection();
    });

    // --- Réglages ---
    $<HTMLInputElement>("s-day").addEventListener("change", (e) => {
      const n = toNumber((e.target as HTMLInputElement).value);
      if (n > 0) state.dayAmount = n;
      save();
      render();
    });
    $("export").addEventListener("click", () => {
      const blob = new Blob([JSON.stringify(state, null, 2)], { type: "application/json" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `argent-${today()}.json`;
      a.click();
      URL.revokeObjectURL(a.href);
    });
    $<HTMLInputElement>("import").addEventListener("change", async (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;
      try {
        const s = JSON.parse(await file.text());
        if (!Array.isArray(s.entries)) throw 0;
        state = { dayAmount: 100, workdays: true, ...s };
        save();
        render();
      } catch {
        $("balance-note").textContent = "Fichier illisible, rien n’a été importé.";
      }
    });

    // --- Rendu ---
    function renderProjection() {
      const target = pDate.value || today();
      const base = balanceAt(target);
      const wd = state.workdays && target > today() ? workdaysUntil(target) : 0;
      const total = base + wd * state.dayAmount;
      $("p-result").textContent = fmt(total);

      const planned = state.entries
        .filter((e) => e.date > today() && e.date <= target)
        .reduce((s, e) => s + e.amount, 0);
      const parts = [`le ${longDate(target)}`, `aujourd’hui ${fmt(balanceAt(today()))}`];
      if (planned) parts.push(`prévus ${signed(planned)}`);
      if (wd) parts.push(`${wd} journée${wd > 1 ? "s" : ""} ${signed(wd * state.dayAmount)}`);
      $("p-detail").textContent = parts.join(" · ");
    }

    function render() {
      const t = today();
      $("today-label").textContent = longDate(t);
      $("balance").textContent = fmt(balanceAt(t));
      $("balance-note").textContent = "";
      $("day-amount").textContent = signed(state.dayAmount);
      $<HTMLInputElement>("s-day").value = String(state.dayAmount);
      $<HTMLInputElement>("p-workdays").checked = state.workdays;

      const doneToday = state.entries.filter((e) => e.date === t && e.label === "Journée").length;
      const hint = $("day-hint");
      hint.classList.toggle("hidden", !doneToday);
      hint.textContent = doneToday > 1 ? `Comptée ${doneToday} fois aujourd’hui.` : "Journée d’aujourd’hui comptée.";

      const list = $("list");
      list.replaceChildren();
      const sorted = [...state.entries].sort((a, b) => b.date.localeCompare(a.date));
      $("empty").classList.toggle("hidden", sorted.length > 0);
      for (const e of sorted) {
        const li = document.createElement("li");
        li.className = "flex items-center gap-3 border-b border-hairline py-3";
        const future = e.date > t;
        li.innerHTML = `
          <div class="min-w-0 flex-1">
            <p class="truncate text-[15px] text-ink"></p>
            <p class="text-[13px] text-muted"></p>
          </div>
          <p class="text-[15px] font-medium tabular-nums"></p>
          <button type="button" class="-mr-2 size-9 rounded-lg text-muted active:bg-surface" aria-label="Supprimer">✕</button>`;
        const [label, date] = li.querySelectorAll("div p");
        label.textContent = e.label || (e.amount > 0 ? "Rentrée" : "Sortie");
        date.textContent = (future ? "Prévu · " : "") + longDate(e.date);
        const amount = li.querySelector(":scope > p")!;
        amount.textContent = signed(e.amount);
        amount.classList.add(e.amount > 0 ? "text-ink" : "text-[#b4234a]");
        if (future) li.classList.add("opacity-70");
        li.querySelector("button")!.addEventListener("click", () => {
          if (!confirmDelete(li)) return;
          state.entries = state.entries.filter((x) => x.id !== e.id);
          save();
          render();
        });
        list.append(li);
      }
      renderProjection();
    }

    // Suppression en deux taps : le premier arme la croix, le second supprime.
    function confirmDelete(li: HTMLElement) {
      const btn = li.querySelector("button")!;
      if (btn.dataset.armed) return true;
      btn.dataset.armed = "1";
      btn.textContent = "Sûr ?";
      btn.className = "-mr-1 h-9 rounded-lg px-2 text-[13px] font-medium text-[#b4234a]";
      setTimeout(() => render(), 2500);
      return false;
    }

    setSign(-1);
    $<HTMLInputElement>("f-date").value = today();
    pDate.value = today();
    render();
  </script>
</Base>
